# Native libraries resolve these entry points by the original JNI symbol name.
-keepclasseswithmembernames,includedescriptorclasses class * {
    native <methods>;
}

# linux_i2c_jni.c constructs this exception via FindClass/GetMethodID.
-keep,allowoptimization class com.shilapi.xcertplay.transport.LinuxI2cNativeException {
    <init>(int, java.lang.String);
}

# Preserve useful crash positions; mapping.txt is retained privately with each build.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile
